# Local working artifacts (processing, renders, extraction cache)
.local/
.pytest_cache/
.ruff_cache/
.mypy_cache/
__pycache__/
*.pyc
*.pyo
*.egg-info/
.venv/
.venv.bak/
venv/

# Environment / secrets
.env
.env.*
!.env.example

# Tooling generated outputs that are rebuilt deterministically
knowledge/book/*.jsonl
knowledge/book/*.json
knowledge/book/*__extract.json
knowledge/graph/*.jsonl
knowledge/graph/graph.json
knowledge/synthesized/*.jsonl
knowledge/synthesized/*.md
knowledge/modern/*.jsonl
knowledge/modern/current-testing-practices.md
book.cleaned.md
evals/results/
