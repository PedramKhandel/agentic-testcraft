# agentic-testcraft runtime configuration (example)
# Copy to .env and edit.  Never commit real secrets.

# Extraction / synthesis provider selection.
# Set AT_LLM_PROVIDER to "native-agent" to run without external credentials.
AT_LLM_PROVIDER=native-agent
# AT_LLM_MODEL=gpt-4o-2024-08-06
# AT_LLM_API_KEY=...

# Extraction behaviour
AT_EXTRACTION_CACHE=true
