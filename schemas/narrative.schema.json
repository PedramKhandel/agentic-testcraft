{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-testcraft.dev/schemas/narrative.schema.json",
  "title": "Narrative Record",
  "description": "Source-faithful narrative guidance that is not a discrete pattern, smell, or principle (e.g. the book's philosophy, pattern-form meta-advice, or cross-cutting decision notes).",
  "type": "object",
  "required": ["id", "name", "statement", "source_refs"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^narrative:[a-z0-9-]+$" },
    "name": { "type": "string" },
    "aliases": { "type": "array", "items": { "type": "string" } },
    "statement": { "type": "string" },
    "rationale": { "type": "string" },
    "evidence_ids": { "type": "array", "items": { "type": "string" } },
    "agent_decision_rule": { "type": ["string", "null"] },
    "source_refs": { "$ref": "source-ref.schema.json#/definitions/ref-list" },
    "confidence": { "type": "string", "enum": ["default","preference","warning","exception","context_dependent","historical","certain"] },
    "origin": { "type": "string", "enum": ["book","modern_official","modern_research","inference","project_convention"] }
  },
  "definitions": {
    "ref-list": { "type": "array", "items": { "$ref": "source-ref.schema.json" }, "minItems": 1 }
  }
}
