{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-testcraft.dev/schemas/decision-rule.schema.json",
  "title": "Decision Rule",
  "description": "An operational agent decision rule derived from synthesized knowledge.",
  "type": "object",
  "required": ["id", "trigger", "default_action", "origin", "strength", "applicability"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^rule:[a-z0-9-.]+$" },
    "trigger": { "type": "string" },
    "context": { "type": ["string", "null"] },
    "default_action": { "type": "string" },
    "decision_logic": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["condition", "action"],
        "additionalProperties": false,
        "properties": {
          "condition": { "type": "string" },
          "action": { "type": "string" }
        }
      }
    },
    "exceptions": { "type": "array", "items": { "type": "string" } },
    "warnings": { "type": "array", "items": { "type": "string" } },
    "evidence_ids": { "type": "array", "items": { "type": "string" } },
    "origin": { "type": "string", "enum": ["book","modern_official","modern_research","inference","project_convention"] },
    "strength": { "type": "string", "enum": ["default","preference","warning","exception","context_dependent","historical","certain"] },
    "applicability": { "type": "string" },
    "agent_verification": { "type": "array", "items": { "type": "string" } }
  }
}
