{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-testcraft.dev/schemas/smell.schema.json",
  "title": "Smell Record",
  "description": "A test smell with symptoms, impact, causes, and recommended remediation patterns.",
  "type": "object",
  "required": ["id", "name", "summary", "source_refs"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^smell:[a-z0-9-]+$" },
    "name": { "type": "string" },
    "aliases": { "type": "array", "items": { "type": "string" } },
    "summary": { "type": "string" },
    "symptoms": { "type": "array", "items": { "type": "string" } },
    "impact": { "type": "array", "items": { "type": "string" } },
    "causes": { "type": "array", "items": { "type": "string" } },
    "detection_heuristics": { "type": "array", "items": { "type": "string" } },
    "false_positive_risks": { "type": "array", "items": { "type": "string" } },
    "related_smells": { "type": "array", "items": { "type": "string" } },
    "recommended_patterns": { "type": "array", "items": { "type": "string" } },
    "agent_review_checks": { "type": "array", "items": { "type": "string" } },
    "source_refs": { "$ref": "source-ref.schema.json#/definitions/ref-list" },
    "confidence": { "type": "string", "enum": ["default","preference","warning","exception","context_dependent","historical","certain"] },
    "origin": { "type": "string", "enum": ["book","modern_official","modern_research","inference","project_convention"] }
  },
  "definitions": {
    "ref-list": { "type": "array", "items": { "$ref": "source-ref.schema.json" }, "minItems": 1 }
  }
}
